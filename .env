# Default Docker Compose profile (rw = full sync, ro = read-only)
COMPOSE_PROFILES=rw

# DB Details
POSTGRES_PASSWORD="metadata1337_"
DB_USERNAME="cardano"
DB_PASSWORD="metadata1337_"
DB_NAME="cf_token_metadata_registry"
DB_HOST='db'
DB_PORT='5432'
DB_URL=jdbc:postgresql://${DB_HOST}:5432/${DB_NAME}

# API Details
API_EXPOSED_PORT='8080'
API_LOCAL_BIND_PORT='8080'
API_RO_LOCAL_BIND_PORT='8081'

# Whether the github scheduled job should run on the api or not
TOKEN_METADATA_SYNC_JOB='true'
API_IMAGE_TAG=latest

# GitHub Configuration for Mainnet
GITHUB_ORGANIZATION='cardano-foundation'
GITHUB_PROJECT_NAME='cardano-token-registry'
GITHUB_MAPPINGS_FOLDER='mappings'
GITHUB_TMP_FOLDER='/tmp'
GITHUB_FORCE_CLONE='false'

# Yaci Store / Cardano Node Configuration  
STORE_CARDANO_PROTOCOL_MAGIC='764824073'
STORE_CARDANO_HOST='backbone.mainnet.cardanofoundation.org'
STORE_CARDANO_PORT='3001'
STORE_CARDANO_SYNC_START_SLOT='65836843'
STORE_CARDANO_SYNC_START_BLOCKHASH='cb09cae9c54026afebfe6124189600fc0f76c2299bc9f9c32305944979a12fed'
STORE_SYNCAUTOSTART=true
STORE_BLOCKS_EPOCH_CALCULATION_INTERVAL='14400'

# CIP Configuration
CIP_QUERY_PRIORITY='CIP_68,CIP_26'

# CIP-113 Programmable Tokens — registry-node NFT policy ID (registry.scriptHash) of the official
# mainnet deployment (cip113-programmable-tokens schemaVersion 3, deployment tx bfefbd22…cdb72)
CIP113_REGISTRY_NFT_POLICY_IDS='484e733d122af44e6101988bcc47ed261a7af5c43c797e89d60e3075'

# JVM
# ttl=0 disables JVM DNS caching entirely so the resolver always picks a fresh
# IP from backbone.mainnet.cardanofoundation.org's round-robin pool. The 30s
# default was observed to cause TipFinder/SyncStatusService to stick on a
# stale/unreachable peer IP, producing repeated connection timeouts.
JAVA_OPTS='-Xmx2g -Dnetworkaddress.cache.ttl=0 -Dnetworkaddress.cache.negative.ttl=0'
