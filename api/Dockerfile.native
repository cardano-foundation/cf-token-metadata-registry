# Temurin has no native-image, so the native build stays on Oracle GraalVM, pinned for the same reason as the JVM
# images: a native executable embeds the trust store of the JDK that built it, and the 25.0.5 build (October 2026)
# has none of the compromised eMudhra roots. The runtime image below has no JDK, so it needs no pin for this.
FROM container-registry.oracle.com/graalvm/native-image:25.0.5 AS build

RUN microdnf install -y maven findutils && microdnf clean all

WORKDIR /app
COPY pom.xml .
COPY api/pom.xml api/
COPY common/pom.xml common/
COPY job/pom.xml job/
COPY cli/pom.xml cli/
COPY integration-test/pom.xml integration-test/
RUN mvn dependency:go-offline -pl api,common -am -B

COPY common/ common/
COPY api/ api/
RUN mvn clean package -pl api,common -am -DskipTests -Pnative -B

FROM debian:trixie-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends libz-dev curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/api/target/api /app/api

EXPOSE 8080
ENTRYPOINT ["/app/api", "-Xmx2g", "-Djava.net.preferIPv4Stack=true"]
